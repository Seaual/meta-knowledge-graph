# .env 配置文件
# 复制此文件为 .env 并填入你的 API Key

# ==================== LLM API ====================

# Claude API (推荐)
# 获取：https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio (免费额度备选)
# 获取：https://aistudio.google.com
GOOGLE_API_KEY=...

# 阿里云 Qwen (国产备选)
# 获取：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=...

# ==================== Neo4j 数据库 ====================

# Neo4j 连接配置 (Docker 本地部署)
# Docker 启动命令:
# docker run -d --name neo4j -p 7474:7474 -p 7687:7687 \
#   -e NEO4J_AUTH=neo4j/password -e NEO4J_PLUGINS='["apoc"]' neo4j:latest
USE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ==================== 代理配置 (校园网/机构访问) ====================

# HTTP/HTTPS 代理 (用于访问谷歌学术等)
# 格式：http://用户名：密码@代理服务器：端口
# HTTP_PROXY=http://proxy.your-school.edu.cn:8080
# HTTPS_PROXY=http://proxy.your-school.edu.cn:8080

# SOCKS 代理 (如校园网需要)
# SOCKS_PROXY=socks5://proxy.your-school.edu.cn:1080

# ==================== 爬虫配置 ====================

# 谷歌学术爬虫设置
SCHOLAR_WAIT_TIME=30  # 等待人工验证时间 (秒)
SCHOLAR_USE_USER_PROFILE=true  # 使用用户 Chrome 配置文件

# 请求延迟 (秒)，避免被封
CRAWLER_DELAY_MIN=1
CRAWLER_DELAY_MAX=3

# ==================== 其他配置 ====================

# 论文下载目录
PAPERS_DIR=papers

# 数据库类型 (sqlite 或 neo4j)
DB_TYPE=sqlite

# 调试模式
DEBUG=false

# ==================== Semantic Scholar ====================

# Semantic Scholar API Key (免费申请)
# 获取：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
